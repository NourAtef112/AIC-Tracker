submission/predictions/
submission/model/

# ONNX exports and quantized models (generated — reproduce with export_onnx.py / quantize.py)
*.onnx
*.ort

# Evaluation results (generated)
evaluation/

# TensorBoard logs
tensorboard/

# OSTrack competition config
OS_Track Model/OSTrack/experiments/ostrack/comp_finetune.yaml
