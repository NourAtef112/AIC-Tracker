# Python artifacts
__pycache__/
*.py[cod]
*.pyd
*.so
*.egg-info/
*.egg
.eggs/
dist/
build/

# Data (large video files, metadata)
data/dataset*/
data/metadata/

# Model weights (large binaries)
OS_Track Model/pretrained/
HIT Model/pretrained/
SGLA_Track Model/pretrained/

# Cloned/submodule repos
OS_Track Model/OSTrack/
OS_Track Model/OSTrack/data/
SGLA_Track Model/SGLATrack/

