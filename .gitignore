.claude/
.obsidian/
.vscode/
.idea/
*.swp
*.swo

# Personal brain & notes
CLAUDE.md
COMMANDS.md
brainstorms/
decisions/
ideas/

# OS-specific
.DS_Store
Thumbs.db

# Misc runtime
*.log
.env

# Extracted frames (generated from source videos — reproduce with convert_dataset.py)
frames/
**/frames/
frames/**/*.jpg
frames/**/*.png
frames/**/*.jpeg

# Inference outputs (generated — reproduce with run_inference.py)
predictions/

